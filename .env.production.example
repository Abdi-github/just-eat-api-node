NODE_ENV=production
PORT=4005
API_VERSION=v1
API_PREFIX=/api

MONGODB_URI=mongodb://mongodb:27017/justeat_prod
MONGODB_DB_NAME=justeat_prod

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=justeat.swiftapp.ch
JWT_AUDIENCE=justeat.swiftapp.ch

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS_GUEST=100
RATE_LIMIT_MAX_REQUESTS_AUTH=300
RATE_LIMIT_MAX_REQUESTS_RESTAURANT=500
RATE_LIMIT_MAX_REQUESTS_ADMIN=1000

CORS_ORIGIN=https://justeat-react.swiftapp.ch,https://justeat-vue.swiftapp.ch,https://justeat-angular.swiftapp.ch,https://justeat-admin.swiftapp.ch
CORS_CREDENTIALS=true

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=justeat

LOG_LEVEL=warn
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

DEFAULT_LANGUAGE=de
SUPPORTED_LANGUAGES=en,fr,de,it

BCRYPT_SALT_ROUNDS=12
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@justeat.swiftapp.ch
MAIL_FROM_NAME=Just Eat
MAIL_SECURE=false
MAIL_REPLY_TO=support@justeat.swiftapp.ch

FRONTEND_URL=https://justeat-react.swiftapp.ch
FRONTEND_ADMIN_URL=https://justeat-admin.swiftapp.ch
SUPPORT_EMAIL=support@justeat.swiftapp.ch

STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
STRIPE_API_VERSION=2024-12-18.acacia

TWINT_MERCHANT_ID=YOUR_TWINT_MERCHANT_ID
TWINT_MERCHANT_SECRET=your_twint_merchant_secret
TWINT_API_URL=https://justeat-api.swiftapp.ch/api/v1/payments/twint/sandbox
TWINT_SANDBOX_MODE=true
TWINT_SESSION_TIMEOUT_MINUTES=5

POSTFINANCE_SPACE_ID=YOUR_POSTFINANCE_SPACE_ID
POSTFINANCE_USER_ID=YOUR_POSTFINANCE_USER_ID
POSTFINANCE_API_SECRET=your_postfinance_api_secret
POSTFINANCE_API_URL=https://justeat-api.swiftapp.ch/api/v1/payments/postfinance/sandbox
