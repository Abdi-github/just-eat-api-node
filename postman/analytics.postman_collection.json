{
  "info": {
    "name": "Just Eat - Analytics",
    "description": "Analytics module endpoints — platform dashboard, restaurant dashboard, revenue time series, top items, top restaurants",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:4005/api/v1" },
    { "key": "admin_token", "value": "" },
    { "key": "owner_token", "value": "" },
    { "key": "customer_token", "value": "" },
    { "key": "restaurant_id", "value": "6993a9f77dcee68d585a0bed" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/public/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@justeat-clone.ch\",\n  \"password\": \"Password123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('admin_token', pm.response.json().data.tokens.access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Restaurant Owner",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/public/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner.bigburger@example.ch\",\n  \"password\": \"Password123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('owner_token', pm.response.json().data.tokens.access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Customer (for RBAC test)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/public/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@example.ch\",\n  \"password\": \"Password123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('customer_token', pm.response.json().data.tokens.access_token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "⚙️ Admin Analytics",
      "item": [
        {
          "name": "Platform Dashboard (default - last 30 days)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/analytics/dashboard",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has success true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('Has overview data', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data).to.have.property('overview');",
                  "  pm.expect(data).to.have.property('order_status_breakdown');",
                  "  pm.expect(data).to.have.property('order_type_breakdown');",
                  "  pm.expect(data).to.have.property('payment_method_breakdown');",
                  "  pm.expect(data).to.have.property('restaurant_status_breakdown');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Platform Dashboard (this_year preset)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/admin/analytics/dashboard?preset=this_year",
              "host": ["{{base_url}}"],
              "path": ["admin", "analytics", "dashboard"],
              "query": [{ "key": "preset", "value": "this_year" }]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has order data', () => {",
                  "  const overview = pm.response.json().data.overview;",
                  "  pm.expect(overview.total_orders).to.be.a('number');",
                  "  pm.expect(overview.total_revenue).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Platform Dashboard (custom date range)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/admin/analytics/dashboard?from=2026-01-01&to=2026-12-31",
              "host": ["{{base_url}}"],
              "path": ["admin", "analytics", "dashboard"],
              "query": [
                { "key": "from", "value": "2026-01-01" },
                { "key": "to", "value": "2026-12-31" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Platform Revenue (monthly)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/admin/analytics/revenue?preset=this_year&period=monthly",
              "host": ["{{base_url}}"],
              "path": ["admin", "analytics", "revenue"],
              "query": [
                { "key": "preset", "value": "this_year" },
                { "key": "period", "value": "monthly" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array of time series', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data).to.be.an('array');",
                  "  if (data.length > 0) {",
                  "    pm.expect(data[0]).to.have.property('date');",
                  "    pm.expect(data[0]).to.have.property('revenue');",
                  "    pm.expect(data[0]).to.have.property('orders');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Platform Revenue (daily)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/admin/analytics/revenue?preset=this_year&period=daily",
              "host": ["{{base_url}}"],
              "path": ["admin", "analytics", "revenue"],
              "query": [
                { "key": "preset", "value": "this_year" },
                { "key": "period", "value": "daily" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Top Restaurants",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/admin/analytics/top-restaurants?preset=this_year&limit=5",
              "host": ["{{base_url}}"],
              "path": ["admin", "analytics", "top-restaurants"],
              "query": [
                { "key": "preset", "value": "this_year" },
                { "key": "limit", "value": "5" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array of restaurants', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data).to.be.an('array');",
                  "  if (data.length > 0) {",
                  "    pm.expect(data[0]).to.have.property('restaurant_id');",
                  "    pm.expect(data[0]).to.have.property('name');",
                  "    pm.expect(data[0]).to.have.property('total_revenue');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Validation - Invalid preset (400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/admin/analytics/dashboard?preset=invalid_value",
              "host": ["{{base_url}}"],
              "path": ["admin", "analytics", "dashboard"],
              "query": [{ "key": "preset", "value": "invalid_value" }]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Validation error', () => pm.expect(pm.response.json().success).to.be.false);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🍽️ Restaurant Analytics",
      "item": [
        {
          "name": "Restaurant Dashboard",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/restaurant/{{restaurant_id}}/analytics/dashboard?preset=this_year",
              "host": ["{{base_url}}"],
              "path": ["restaurant", "{{restaurant_id}}", "analytics", "dashboard"],
              "query": [{ "key": "preset", "value": "this_year" }]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{owner_token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has restaurant overview', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data).to.have.property('restaurant_id');",
                  "  pm.expect(data).to.have.property('overview');",
                  "  pm.expect(data.overview).to.have.property('avg_rating');",
                  "  pm.expect(data.overview).to.have.property('review_count');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Restaurant Revenue (daily)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/restaurant/{{restaurant_id}}/analytics/revenue?preset=this_year&period=daily",
              "host": ["{{base_url}}"],
              "path": ["restaurant", "{{restaurant_id}}", "analytics", "revenue"],
              "query": [
                { "key": "preset", "value": "this_year" },
                { "key": "period", "value": "daily" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{owner_token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns time series array', () => {",
                  "  pm.expect(pm.response.json().data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Restaurant Revenue (weekly)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/restaurant/{{restaurant_id}}/analytics/revenue?preset=this_year&period=weekly",
              "host": ["{{base_url}}"],
              "path": ["restaurant", "{{restaurant_id}}", "analytics", "revenue"],
              "query": [
                { "key": "preset", "value": "this_year" },
                { "key": "period", "value": "weekly" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{owner_token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Restaurant Top Items",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/restaurant/{{restaurant_id}}/analytics/top-items?preset=this_year&limit=10",
              "host": ["{{base_url}}"],
              "path": ["restaurant", "{{restaurant_id}}", "analytics", "top-items"],
              "query": [
                { "key": "preset", "value": "this_year" },
                { "key": "limit", "value": "10" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{owner_token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array of items', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data).to.be.an('array');",
                  "  if (data.length > 0) {",
                  "    pm.expect(data[0]).to.have.property('menu_item_id');",
                  "    pm.expect(data[0]).to.have.property('name');",
                  "    pm.expect(data[0]).to.have.property('total_ordered');",
                  "    pm.expect(data[0]).to.have.property('total_revenue');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "RBAC - Owner can't access other restaurant (403/404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/restaurant/6993a9f77dcee68d585a0be9/analytics/dashboard?preset=this_year",
              "host": ["{{base_url}}"],
              "path": ["restaurant", "6993a9f77dcee68d585a0be9", "analytics", "dashboard"],
              "query": [{ "key": "preset", "value": "this_year" }]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{owner_token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Access denied', () => {",
                  "  pm.expect([403, 404]).to.include(pm.response.code);",
                  "  pm.expect(pm.response.json().success).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🔒 RBAC Tests",
      "item": [
        {
          "name": "Customer denied admin analytics (403)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/analytics/dashboard",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 403', () => pm.response.to.have.status(403));",
                  "pm.test('Access denied', () => pm.expect(pm.response.json().success).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "No auth token (401)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/analytics/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
