  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-login if no admin token",
          "if (!pm.variables.get('admin_token') || pm.variables.get('admin_token') === '') {",
          "  pm.sendRequest({",
          "    url: pm.variables.get('base_url') + '/public/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ email: 'admin@justeat-clone.ch', password: 'Password123!' }) }",
          "  }, (err, res) => {",
          "    if (!err && res.code === 200) {",
          "      const token = res.json().data.tokens.access_token;",
          "      pm.variables.set('admin_token', token);",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
