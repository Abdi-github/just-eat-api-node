    {
      "name": "⚙️ Admin Coupons",
      "item": [
        {
          "name": "Create Platform Coupon (Percentage)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/admin/promotions/coupons",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"WELCOME20\",\n  \"description\": \"Welcome discount for new customers\",\n  \"discount_type\": \"PERCENTAGE\",\n  \"discount_value\": 20,\n  \"minimum_order\": 25,\n  \"maximum_discount\": 15,\n  \"scope\": \"PLATFORM\",\n  \"usage_limit\": 1000,\n  \"per_user_limit\": 1,\n  \"valid_from\": \"2025-01-01T00:00:00.000Z\",\n  \"valid_until\": \"2027-12-31T23:59:59.000Z\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Coupon created', () => pm.expect(pm.response.json().success).to.be.true);",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('coupon_id', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Platform Coupon (Flat)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/admin/promotions/coupons",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"FLAT5OFF\",\n  \"description\": \"CHF 5 off any order\",\n  \"discount_type\": \"FLAT\",\n  \"discount_value\": 5,\n  \"minimum_order\": 15,\n  \"scope\": \"PLATFORM\",\n  \"valid_until\": \"2027-12-31T23:59:59.000Z\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Flat coupon created', () => pm.expect(pm.response.json().data.discount_type).to.eql('FLAT'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List All Coupons",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/promotions/coupons",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has data array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "pm.test('Has pagination', () => pm.expect(pm.response.json().meta).to.have.property('total'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Coupon by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/promotions/coupons/{{coupon_id}}",
