          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Updated', () => pm.expect(pm.response.json().data.discount_value).to.eql(25));"
                ]
