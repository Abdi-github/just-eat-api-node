    {
      "name": "Update Profile",
      "item": [
        {
          "name": "Update Profile - Success",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Updated\",\n  \"last_name\": \"Name\",\n  \"phone\": \"+41 79 999 8888\",\n  \"preferred_language\": \"fr\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/public/auth/me",
              "host": ["{{base_url}}"],
              "path": ["public", "auth", "me"]
            },
            "description": "Update the authenticated user's profile. Only updatable fields are accepted."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
