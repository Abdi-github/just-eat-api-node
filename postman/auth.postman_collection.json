{
  "info": {
    "_postman_id": "je-auth-collection-001",
    "name": "Just Eat API - Auth Module",
    "description": "Authentication & Authorization endpoints for the Just Eat API.\n\nIncludes: Register, Login, Token Refresh, Profile, Change Password, Logout, Email Verification, Password Reset, Applications (Restaurant Owner & Courier).\n\nTest credentials:\n- Super Admin: admin@justeat-clone.ch / Password123!\n- Customer: customer1@example.ch / Password123!\n- Restaurant Owner: owner.bigburger@example.ch / Password123!\n- Courier: courier1@justeat-clone.ch / Password123!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "item": [
        {
          "name": "Register - Success",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.ch\",\n  \"password\": \"SecurePass123!\",\n  \"first_name\": \"Max\",\n  \"last_name\": \"Muster\",\n  \"phone\": \"+41 79 123 4567\",\n  \"preferred_language\": \"de\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/public/auth/register",
              "host": ["{{base_url}}"],
              "path": ["public", "auth", "register"]
            },
            "description": "Register a new customer account. Auto-assigns 'customer' role."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Success true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('Has tokens', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.tokens).to.have.property('access_token');",
                  "  pm.expect(data.tokens).to.have.property('refresh_token');",
                  "});",
                  "pm.test('Has user', () => {",
                  "  const user = pm.response.json().data.user;",
                  "  pm.expect(user.email).to.eql('newuser@example.ch');",
                  "  pm.expect(user.roles).to.include('customer');",
                  "});",
                  "// Save tokens",
                  "if (pm.response.json().data) {",
                  "  pm.environment.set('auth_token', pm.response.json().data.tokens.access_token);",
                  "  pm.environment.set('refresh_token', pm.response.json().data.tokens.refresh_token);",
                  "  pm.environment.set('user_id', pm.response.json().data.user.id);",
                  "  pm.environment.set('token_expiry', Date.now() + 14 * 60 * 1000);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
