            },
            "description": "Refresh access token using a valid refresh token. Returns new token pair."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has new tokens', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data).to.have.property('access_token');",
                  "  pm.expect(data).to.have.property('refresh_token');",
                  "});",
                  "// Update tokens",
                  "if (pm.response.json().data) {",
