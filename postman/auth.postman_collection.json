            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@example.ch\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/public/auth/login",
              "host": ["{{base_url}}"],
              "path": ["public", "auth", "login"]
            },
            "description": "Login as customer. Saves tokens to environment."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('Has customer role', () => {",
                  "  pm.expect(pm.response.json().data.user.roles).to.include('customer');",
                  "});",
                  "pm.test('Has permissions', () => {",
                  "  pm.expect(pm.response.json().data.user.permissions.length).to.be.greaterThan(0);",
                  "});",
                  "// Save tokens",
                  "if (pm.response.json().data) {",
                  "  pm.environment.set('auth_token', pm.response.json().data.tokens.access_token);",
                  "  pm.environment.set('refresh_token', pm.response.json().data.tokens.refresh_token);",
                  "  pm.environment.set('user_id', pm.response.json().data.user.id);",
                  "  pm.environment.set('token_expiry', Date.now() + 14 * 60 * 1000);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
