# Application
NODE_ENV=development
PORT=4005
API_VERSION=v1
API_PREFIX=/api

# Database - MongoDB
MONGODB_URI=mongodb://mongodb:27017/justeat_dev
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_DB_NAME=justeat_dev

# Cache - Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=just-eat.ch
JWT_AUDIENCE=just-eat.ch

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS_GUEST=100
RATE_LIMIT_MAX_REQUESTS_AUTH=300
RATE_LIMIT_MAX_REQUESTS_RESTAURANT=500
RATE_LIMIT_MAX_REQUESTS_ADMIN=1000

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:4005
CORS_CREDENTIALS=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=justeat

# Image Upload Settings
MAX_IMAGE_SIZE=10485760
MAX_IMAGES_PER_BATCH=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ENABLE_IMAGE_OPTIMIZATION=true
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=200
MAX_IMAGE_WIDTH=2000
IMAGE_QUALITY=85

# Logging
LOG_LEVEL=debug
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# Internationalization
DEFAULT_LANGUAGE=de
SUPPORTED_LANGUAGES=en,fr,de,it

# Security
BCRYPT_SALT_ROUNDS=12

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Email (Mailpit for development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@just-eat.ch
MAIL_FROM_NAME=just-eat.ch
MAIL_SECURE=false
MAIL_REPLY_TO=support@just-eat.ch

# Frontend URLs
FRONTEND_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174
SUPPORT_EMAIL=support@just-eat.ch

# Payment - Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_API_VERSION=2024-12-18.acacia

# Payment - TWINT (Sandbox)
TWINT_MERCHANT_ID=SANDBOX_MERCHANT_001
TWINT_MERCHANT_SECRET=sandbox_secret_key
TWINT_API_URL=http://localhost:4005/api/v1/payments/twint/sandbox
TWINT_SANDBOX_MODE=true
TWINT_SESSION_TIMEOUT_MINUTES=5

# Payment - PostFinance (Sandbox)
POSTFINANCE_SPACE_ID=SANDBOX_SPACE_001
POSTFINANCE_USER_ID=SANDBOX_USER_001
POSTFINANCE_API_SECRET=sandbox_api_secret
POSTFINANCE_API_URL=http://localhost:4005/api/v1/payments/postfinance/sandbox
POSTFINANCE_SANDBOX_MODE=true
POSTFINANCE_SESSION_TIMEOUT_MINUTES=15

# Payment - Cash
CASH_PAYMENT_ENABLED=true

# Payment - Global
PAYMENT_SESSION_TTL=1800
MAX_PAYMENT_ATTEMPTS=3
